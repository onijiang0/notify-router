# notify-router 环境变量示例
#
# 用法: 复制为 .env, 填入真实值, 与 docker-compose.yml 放在同一目录。
#       docker compose 会自动读取 .env; .env 已被 .gitignore 忽略, 不会进版本库。
#
#   cp .env.example .env
#   vi .env

# ── Web 管理界面登录鉴权(强烈建议开启) ────────────────────────────────
# 两个都非空才生效。/notify 与 /health 永远公开, 脚本投递不受影响。
AUTH_USER=admin
AUTH_PASS=

# ── 首次启动播种渠道(可选) ────────────────────────────────────────────
# 企业微信群机器人 webhook 的 key 部分
# (完整 webhook 形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx)
QYWX_KEY=

# 钉钉群机器人: access_token + 加签 secret(以 SEC 开头)
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=

# 无规则命中时: true=发全部启用渠道; false=不发
FALLBACK_ALL=true

# ── (可选) Gist 云备份 ────────────────────────────────────────────────
# 卷丢失后自动从云端恢复配置, 详见 README「配置持久化与备份」
# GIST_TOKEN=
# GIST_ID=

# ── (可选) 自定义升级检测目标 ─────────────────────────────────────────
# fork 本仓库后, 把「系统设置 → 检测升级」指向你自己的镜像仓库
# UPGRADE_REPO=你的用户名/notify-router
